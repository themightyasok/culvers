{
  "name": "culvers",
  "version": "1.0.0",
  "private": true,
  "description": "WordPress theme — BladeOne, Tailwind CSS v4, Vite, ACF flexible components",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp css/app.css app.css",
    "watch": "vite build --watch",
    "lint": "npm run lint:js",
    "lint:js": "eslint resources/scripts --ext .js",
    "lint:js:fix": "eslint resources/scripts --ext .js --fix",
    "format": "prettier --write \"resources/**/*.{js,css}\"",
    "format:check": "prettier --check \"resources/**/*.{js,css}\"",
    "verify": "npm run lint && npm run format:check && npm run build && composer lint",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.11",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.11",
    "vite": "^6.3.5"
  },
  "lint-staged": {
    "resources/scripts/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "resources/**/*.{css}": [
      "prettier --write"
    ],
    "app/**/*.php": [
      "vendor/bin/phpcs"
    ]
  }
}
