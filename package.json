{
  "name": "culvers",
  "version": "1.0.0",
  "private": true,
  "description": "WordPress theme — BladeOne, Tailwind CSS v4, Vite, ACF flexible components",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p css js && cp dist/css/app.css css/app.css && cp dist/css/app.css app.css && cp dist/js/app.js js/app.js",
    "watch": "vite build --watch",
    "lint": "npm run lint:js",
    "lint:js": "eslint \"resources/scripts/**/*.js\"",
    "lint:js:fix": "eslint \"resources/scripts/**/*.js\" --fix",
    "format": "prettier --write \"resources/**/*.{js,css}\" \"tailwind.config.js\" \"vite.config.js\"",
    "format:check": "prettier --check \"resources/**/*.{js,css}\" \"tailwind.config.js\" \"vite.config.js\"",
    "verify": "npm run lint && npm run format:check && npm run build && composer lint && composer analyse",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "alpinejs": "^3.15.12",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  },
  "lint-staged": {
    "tailwind.config.js": [
      "prettier --write"
    ],
    "vite.config.js": [
      "prettier --write"
    ],
    "resources/scripts/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "resources/**/*.css": [
      "prettier --write"
    ],
    "app/**/*.php": [
      "vendor/bin/phpcs"
    ]
  }
}
