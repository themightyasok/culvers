{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "canvas", "color": "#09090b", "name": "Canvas" },
        { "slug": "surface", "color": "#18181b", "name": "Surface" },
        { "slug": "surface-muted", "color": "#27272a", "name": "Surface muted" },
        { "slug": "border-subtle", "color": "#3f3f46", "name": "Border subtle" },
        { "slug": "text", "color": "#fafafa", "name": "Text" },
        { "slug": "text-muted", "color": "#a1a1aa", "name": "Text muted" },
        { "slug": "glowleaf", "color": "#d4ff50", "name": "Glowleaf" },
        { "slug": "deep-moss", "color": "#2e301e", "name": "Deep moss" },
        { "slug": "faded-olive", "color": "#4f5438", "name": "Faded olive" },
        { "slug": "dustleaf", "color": "#8b8c67", "name": "Dustleaf" },
        { "slug": "light-brown", "color": "#beb6aa", "name": "Light brown" },
        { "slug": "light-cream", "color": "#fdfcf3", "name": "Light cream" },
        { "slug": "off-white", "color": "#ededeb", "name": "Off white" },
        { "slug": "lighter-cream", "color": "#fffefa", "name": "Lighter cream" },
        { "slug": "brand-500", "color": "#d4ff50", "name": "Brand 500" },
        { "slug": "brand-600", "color": "#d4ff50", "name": "Brand 600" },
        { "slug": "brand-700", "color": "#2e301e", "name": "Brand 700" },
        { "slug": "white", "color": "#ffffff", "name": "White" },
        { "slug": "black", "color": "#000000", "name": "Black" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"DM Sans Variable\", ui-sans-serif, system-ui, sans-serif",
          "slug": "sans",
          "name": "Body"
        },
        {
          "fontFamily": "\"Cormorant Garamond Variable\", Georgia, serif",
          "slug": "heading",
          "name": "Heading"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)"
        }
      },
      "link": {
        "typography": {
          "textDecoration": "none"
        },
        ":link": {
          "typography": {
            "textDecoration": "none"
          }
        },
        ":any-link": {
          "typography": {
            "textDecoration": "none"
          }
        },
        ":hover": {
          "typography": {
            "textDecoration": "none"
          }
        },
        ":focus": {
          "typography": {
            "textDecoration": "none"
          }
        },
        ":focus-visible": {
          "typography": {
            "textDecoration": "none"
          }
        },
        ":active": {
          "typography": {
            "textDecoration": "none"
          }
        },
        ":visited": {
          "typography": {
            "textDecoration": "none"
          }
        }
      }
    }
  }
}
